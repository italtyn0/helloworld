# ---- Telegram ----
BOT_TOKEN=
# Comma-separated Telegram user IDs that can approve requests
ADMIN_IDS=

# ---- 3X-UI panel ----
# Full panel URL including its secret base path, e.g. https://panel.example.com:2053/AbCdEf123
PANEL_URL=
# Panel → Settings → Security → API Token
PANEL_TOKEN=
PANEL_VERIFY_SSL=true

# Inbound that new clients are added to (looked up by remark; set INBOUND_ID to skip the lookup)
INBOUND_REMARK=AltynCDN
INBOUND_ID=

# Traffic quota per coworker, in GB
TRAFFIC_GB=15

# ---- Links ----
# Links returned by the panel are used when they contain CDN_DOMAIN; otherwise VLESS_TEMPLATE is used.
CDN_DOMAIN=
# A working vless link with the UUID replaced by {uuid} and the part after # by {remark}.
# install.sh builds this for you from one of your existing links.
VLESS_TEMPLATE=
# Subscription base URL ending in "/" (the subId is appended).
# Leave empty to read it from the panel's subscription settings.
SUB_URL=

DB_PATH=data/bot.db
