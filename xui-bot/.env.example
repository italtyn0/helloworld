# ---- Telegram ----
BOT_TOKEN=
# Comma-separated Telegram user IDs that can approve requests
ADMIN_IDS=

# ---- 3X-UI panel ----
# Full panel URL including its secret base path, e.g. https://panel.example.com:2053/AbCdEf123
PANEL_URL=
# Panel → Settings → Security → API Token
PANEL_TOKEN=
PANEL_VERIFY_SSL=true

# Inbound that new clients are added to (looked up by remark; set INBOUND_ID to skip the lookup)
INBOUND_REMARK=AltynCDN
INBOUND_ID=

# Traffic quota per coworker, in GB
TRAFFIC_GB=15

# Low-traffic alert: users are warned once when their remaining traffic drops to this many GB,
# with a button to ask for more. Checked every TRAFFIC_CHECK_MINUTES.
LOW_TRAFFIC_GB=2
TRAFFIC_CHECK_MINUTES=30
# GB added to a user's quota when the admin approves a "more traffic" request
EXTRA_TRAFFIC_GB=5

# ---- Links ----
# Links returned by the panel are used when they contain CDN_DOMAIN; otherwise VLESS_TEMPLATE is used.
CDN_DOMAIN=
# A working vless link with the UUID replaced by {uuid} and the part after # by {remark}.
# install.sh builds this for you from one of your existing links.
VLESS_TEMPLATE=
# Subscription base URL ending in "/" (the subId is appended).
# Leave empty to read it from the panel's subscription settings.
SUB_URL=

# ---- Web form for people who cannot reach Telegram ----
# Port for the request page (http://SERVER:WEB_PORT/). Leave empty to turn it off.
# Open it in the firewall (ufw allow 8080/tcp), or put it behind your CDN/reverse proxy for HTTPS.
WEB_PORT=8080
WEB_HOST=0.0.0.0
# Public address of the web form, e.g. https://95.182.91.213:8080 . When set, users you add with
# ➕ افزودن کاربر also get a private web page and the bot shows you its link.
WEB_PUBLIC_URL=
# HTTPS certificate for the web form (e.g. the panel's). install.sh fills these in when it finds
# /root/cert/<panel domain>/, and restarts the bot whenever the certificate is renewed.
# Leave empty to serve plain http.
WEB_CERT_FILE=
WEB_KEY_FILE=

DB_PATH=data/bot.db
